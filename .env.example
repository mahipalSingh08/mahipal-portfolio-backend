# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Runtime
ENVIRONMENT=development
APP_NAME=Portfolio Backend API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
PORT=8000
OPENAI_API_KEY=sk-proj-mlT

# API docs are enabled by default outside production.
# Set to false in production unless public docs are intentional.
ENABLE_DOCS=true

# MongoDB Atlas connection string and database name
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here
MONGODB_DATABASE=portfolio

# Comma-separated list of allowed frontend origins.
# Example: https://mahipal.tech,https://www.mahipal.tech
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Authentication
AUTH_USER_ID=your_secure_username
AUTH_PASSWORD_HASH=your_secure_password_hash_here
AUTH_SESSION_DURATION_MINUTES=60
